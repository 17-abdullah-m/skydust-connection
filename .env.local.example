# Local only. Do not import this file into Vercel Preview or Production.
# Those environments already have DATABASE_URL — adding it again fails with:
# "A variable with the name DATABASE_URL already exists for the targets preview and production"
#
# On Vercel: leave the existing DATABASE_URL as-is (edit it, do not add a new one).
# Local Next.js reads this file. Local Prisma CLI reads prisma/.env.

DATABASE_URL="file:./dev.db"
AUTH_SECRET=
APP_URL=
